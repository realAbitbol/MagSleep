#!/bin/bash
# Pre-commit hook for MagSleep.
#
# Blocks a commit unless ALL of these pass:
#   - SwiftLint (warnings treated as errors)
#   - Periphery dead-code scan
#   - swift test
#   - release build with warnings-as-errors
#
# Installed with `make install-hooks` (sets core.hooksPath to
# scripts/git-hooks), so every clone gets the same hook without copying.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Fail fast with helpful guidance instead of a bare "command not found" when
# the tools aren't installed.
if ! command -v swiftlint >/dev/null 2>&1 || ! command -v periphery >/dev/null 2>&1; then
    echo "error: the pre-commit hook needs swiftlint and periphery." >&2
    echo "Install them with: brew install swiftlint periphery" >&2
    exit 1
fi

echo "==> SwiftLint"
swiftlint lint --strict

echo "==> Periphery dead-code scan"
periphery scan --strict

echo "==> swift test"
swift test

echo "==> release build (warnings as errors)"
swift build -c release --arch arm64 -Xswiftc -warnings-as-errors

echo "==> all checks passed"
